# IDP Configuration — copy to .env and adjust

# --- Вариант 1: Qwen-3.8 (27B AWQ-INT4, по умолчанию) ---
IDP_VL_MODEL_DIR=new_vl
IDP_VL_MODEL=cyankiwi/Qwen3.8-27B-AWQ-INT4
IDP_VLLM_QUANTIZATION=compressed-tensors
IDP_VLLM_DTYPE=half
IDP_VLLM_GPU_MEMORY_UTILIZATION=0.9
IDP_VLLM_MAX_MODEL_LEN=32768
IDP_VLLM_KV_CACHE_MEMORY=15000000000
IDP_VLLM_KV_CACHE_DTYPE=fp8
IDP_VLLM_MAX_NUM_SEQS=64
IDP_VLLM_MAX_NUM_BATCHED_TOKENS=8192
IDP_VLLM_ENABLE_PREFIX_CACHING=true
IDP_VLLM_ASYNC_SCHEDULING=true
IDP_VLLM_ATTENTION_BACKEND=FLASHINFER
IDP_VLLM_OMP_NUM_THREADS=1
IDP_VLLM_ENABLE_STARTUP_PLAN=1
IDP_VLLM_CACHE_ROOT=/models/hf-cache
IDP_VL_MAX_IMAGES=2
IDP_VL_CONCURRENCY=16
IDP_VL_ENDPOINTS=http://vllm-vl-0:8000/v1,http://vllm-vl-1:8001/v1

# --- Вариант 2: Xiaomi-OCR-0.8 (последняя release, 0.8B) ---
# IDP_VL_MODEL_DIR=xiaomi-ocr-0
# IDP_VL_MODEL=xiaomi-research/Xiaomi-OCR-0
# IDP_VLLM_QUANTIZATION=none
# IDP_VLLM_GPU_MEMORY_UTILIZATION=0.8

# --- Пути ---
IDP_INPUT_ROOT=/input
IDP_OUTPUT_ROOT=/output
IDP_RENDER_DPI=200
IDP_UPSCALE_FACTOR=1
IDP_MAX_IMAGE_DIMENSION=2048

# --- VLM ---
IDP_VL_ENDPOINT=http://vllm-vl:8000/v1
IDP_VL_TIMEOUT_SECONDS=600
IDP_VL_MAX_TOKENS=16384
IDP_VL_MAX_IMAGES=2
IDP_VL_CONCURRENCY=12

# --- Режимы ---
IDP_TEST_MODE=false
IDP_ARTIFACTS_MODE=false
IDP_VISIO_MODE=false
IDP_VISIO_CONTENT=pages

# --- Сущности ---
IDP_MIN_ENTITY_CONFIDENCE=0.3
IDP_ENTITY_SCHEMA_PATH=

# --- Прочее ---
IDP_TRASH_PATH=
IDP_FINETUNE_FEEDBACK_ENABLED=true
IDP_FINETUNE_FEEDBACK_DIR=/output/finetune
