FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip

# Install CPU-only PyTorch from official index
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Install vllm and common ML deps
RUN pip install --no-cache-dir vllm==0.25.0 transformers sentencepiece tokenizers tiktoken huggingface-hub safetensors

# Keep same entrypoint as upstream image (vllm installs /usr/local/bin/vllm)
ENTRYPOINT ["/usr/local/bin/vllm"]
CMD ["serve"]
