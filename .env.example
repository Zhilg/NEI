# IDP Configuration — copy to .env and adjust

# --- Вариант 1: Qwen-3.8 (27B AWQ-INT4, по умолчанию) ---
IDP_VL_MODEL_DIR=new_vl
IDP_VL_MODEL=cyankiwi/Qwen3.8-27B-AWQ-INT4
IDP_VLLM_QUANTIZATION=compressed-tensors
IDP_VLLM_DTYPE=half
IDP_VLLM_GPU_MEMORY_UTILIZATION=0.9
IDP_VLLM_MAX_MODEL_LEN=65536
IDP_VLLM_KV_CACHE_MEMORY=15000000000
IDP_VLLM_KV_CACHE_DTYPE=fp8
# 256 последовательностей на реплику: 4 реплики × 256 = 1024 слота,
# воркер с IDP_VL_CONCURRENCY=128 их не насыщает даже на пике
IDP_VLLM_MAX_NUM_SEQS=256
IDP_VLLM_MAX_NUM_BATCHED_TOKENS=8192
IDP_VLLM_ENABLE_PREFIX_CACHING=true
IDP_VLLM_ASYNC_SCHEDULING=true
IDP_VLLM_ATTENTION_BACKEND=FLASHINFER
IDP_VLLM_OMP_NUM_THREADS=1
IDP_VLLM_ENABLE_STARTUP_PLAN=1
IDP_VLLM_CACHE_ROOT=/models/hf-cache
IDP_VL_MAX_IMAGES=2
# 128 одновременных VLM-запросей на воркер (4 реплики vLLM это выдерживают)
IDP_VL_CONCURRENCY=128
IDP_VL_ENDPOINTS=http://vllm-vl:8000/v1,http://vllm-vl-2:8000/v1,http://vllm-vl-3:8000/v1,http://vllm-vl-4:8000/v1

# --- Вариант 2: Xiaomi-OCR-0.8 (последняя release, 0.8B) ---
# IDP_VL_MODEL_DIR=xiaomi-ocr-0
# IDP_VL_MODEL=xiaomi-research/Xiaomi-OCR-0
# IDP_VLLM_QUANTIZATION=none
# IDP_VLLM_GPU_MEMORY_UTILIZATION=0.8

# --- Пути ---
IDP_INPUT_ROOT=/input
IDP_OUTPUT_ROOT=/output
# 300dpi + 3072px + VLLM_IMAGE_MAX_PIXELS=6.4Мп — пакет для качества OCR
# мелкого шрифта.  Обратная сторона: префил на страницу вырастает ~в 2.5
# раза; если скорость важнее качества — вернуть 200/2048/2500000.
IDP_RENDER_DPI=300
IDP_UPSCALE_FACTOR=1
IDP_MAX_IMAGE_DIMENSION=3072
IDP_VLLM_IMAGE_MAX_PIXELS=6400000

# --- VLM ---
IDP_VL_ENDPOINT=http://vllm-vl:8000/v1
IDP_VL_TIMEOUT_SECONDS=1800
# Бюджет токенов на чанк (2 стр.).  Меньше 2048 — плотные страницы книг
# обрезались бы; при обрезке воркер сам разбивает чанк и переспрашивает.
IDP_VL_MAX_TOKENS=2048
IDP_VL_MAX_IMAGES=2
# дублирует значение выше — см. блок Вариант 1
IDP_VL_CONCURRENCY=128
IDP_VL_MAX_CONTEXT_CHARS=500

# --- Режимы ---
IDP_TEST_MODE=false
IDP_ARTIFACTS_MODE=false
IDP_VISIO_MODE=false
IDP_VISIO_CONTENT=pages

# --- Сущности ---
IDP_MIN_ENTITY_CONFIDENCE=0.3
IDP_ENTITY_SCHEMA_PATH=

# --- Прочее ---
IDP_TRASH_PATH=
IDP_FINETUNE_FEEDBACK_ENABLED=true
IDP_FINETUNE_FEEDBACK_DIR=/output/finetune
