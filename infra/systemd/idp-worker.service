[Unit]
Description=Offline PDF batch worker
Requires=idp-release-validate.service
After=idp-release-validate.service

[Service]
Type=simple
EnvironmentFile=/etc/idp/idp.env
ExecStart=/usr/local/bin/idp worker run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
