[Unit]
Description=Validate active offline IDP release before startup
After=network-pre.target
Before=idp-controller.service idp-worker.service

[Service]
Type=oneshot
Environment=IDP_OFFLINE_MODE=true
Environment=IDP_TELEMETRY_ENABLED=false
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
ExecStart=/usr/local/bin/idp profile validate

[Install]
WantedBy=multi-user.target
