# --- Вариант 1: Qwen-3.8 (27B AWQ-Marlin, по умолчанию) ---
# Требуется ~24 GB VRAM. Модель: mattbucci/Qwen3.8-27B-AWQ (нативный awq_marlin формат)
IDP_VL_MODEL_DIR=new_vl
IDP_VL_MODEL=mattbucci/Qwen3.8-27B-AWQ
IDP_VLLM_QUANTIZATION=awq
IDP_VLLM_DTYPE=half
IDP_VLLM_GPU_MEMORY_UTILIZATION=0.9
IDP_VLLM_MAX_MODEL_LEN=16384
IDP_VLLM_KV_CACHE_MEMORY=15000000000
IDP_VLLM_KV_CACHE_DTYPE=fp8
IDP_VLLM_MAX_NUM_SEQS=64
IDP_VLLM_MAX_NUM_BATCHED_TOKENS=8192
IDP_VLLM_ENABLE_PREFIX_CACHING=true
IDP_VLLM_ASYNC_SCHEDULING=true
IDP_VLLM_ATTENTION_BACKEND=FLASHINFER
IDP_VLLM_OMP_NUM_THREADS=1
IDP_VLLM_ENABLE_STARTUP_PLAN=1
IDP_VLLM_CACHE_ROOT=/models/hf-cache
IDP_VL_MAX_IMAGES=2
IDP_VL_CONCURRENCY=16
IDP_VL_ENDPOINTS=http://vllm-vl-0:8000/v1,http://vllm-vl-1:8001/v1
