# --- Вариант 2: Xiaomi-OCR-0.8 (последняяrelease, 0.8B) ---
# Требуется мало VRAM. Модель: xiaomi-research/Xiaomi-OCR-0
IDP_VL_MODEL_DIR=xiaomi-ocr-0
IDP_VL_MODEL=Xiaomi-OCR-0
IDP_VLLM_QUANTIZATION=none
IDP_VLLM_DTYPE=half
IDP_VLLM_GPU_MEMORY_UTILIZATION=0.8
IDP_VLLM_MAX_MODEL_LEN=32768
IDP_VLLM_KV_CACHE_MEMORY=8000000000
IDP_VLLM_KV_CACHE_DTYPE=fp8
IDP_VLLM_MAX_NUM_SEQS=128
IDP_VLLM_MAX_NUM_BATCHED_TOKENS=16384
IDP_VLLM_ENABLE_PREFIX_CACHING=true
IDP_VLLM_ASYNC_SCHEDULING=true
IDP_VLLM_ATTENTION_BACKEND=FLASHINFER
IDP_VLLM_OMP_NUM_THREADS=1
IDP_VLLM_ENABLE_STARTUP_PLAN=1
IDP_VLLM_CACHE_ROOT=/models/hf-cache
IDP_VL_MAX_IMAGES=1
IDP_VL_CONCURRENCY=8
IDP_VL_ENDPOINTS=http://vllm-vl-0:8000/v1,http://vllm-vl-1:8001/v1
